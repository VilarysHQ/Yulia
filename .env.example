# Copie este archivo a apps/api/.env
# Aplicación
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Opcional: lista completa de orígenes exactos, separados por coma; si se define, sustituye WEB_ORIGIN.
# WEB_ORIGINS=https://web.example.com,https://preview.example.com
API_PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/yulia_dev
DATABASE_SSL=false

# Autenticación (en producción es obligatorio un secreto aleatorio propio de al menos 32 caracteres)
JWT_SECRET=replace-with-at-least-32-random-characters

# Modelo de texto usado con la API key temporal de cada estudiante
GEMINI_MODEL=gemini-3.5-flash-lite

# En desarrollo, SUPABASE_URL solo permite mostrar portadas públicas existentes.
# Las escrituras de Storage se desactivan fuera de producción y no requieren service_role local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_STORAGE_BUCKET=course-covers
